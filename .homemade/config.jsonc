{
  "$schema": "https://www.hmmd.dev/schemas/latest/config.json",

  // Reuse a warmed node_modules snapshot when available and install anything
  // added to package.json since that snapshot was created.
  "install": ["npm install"],
  "warmup": ["npm install"],

  "services": {
    "web": {
      // A fresh VM works without secrets. Set DEMO_MODE=false together with
      // OPENROUTER_API_KEY in project environment variables for real mutations.
      "cmd": "DEMO_MODE=\"${DEMO_MODE:-true}\" APP_URL=\"${APP_URL:-$HOMEMADE_URL_3000}\" npm run dev -- --hostname 0.0.0.0 --port 3000",
      "port": 3000,
      "url": true
    }
  }
}
