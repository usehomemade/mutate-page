# Core
APP_URL=http://localhost:3000
APP_SECRET=replace-with-at-least-32-random-characters
DATABASE_PATH=./data/mutate.sqlite

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-coder-next
# Rare macromutations use a tiny separate call before the page generation.
OPENROUTER_MACROMUTATION_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_MACROMUTATION_MAX_OUTPUT_TOKENS=120
OPENROUTER_MACROMUTATION_TIMEOUT_SECONDS=8
# Every mutation first asks a small model for a neutral content brief, kept
# separate from the page generator so it never becomes aware of this system.
OPENROUTER_BRIEF_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_BRIEF_MAX_OUTPUT_TOKENS=500
OPENROUTER_BRIEF_TIMEOUT_SECONDS=10
OPENROUTER_TEMPERATURE=0.9
OPENROUTER_MAX_OUTPUT_TOKENS=6000
OPENROUTER_TIMEOUT_SECONDS=45
OPENROUTER_ZDR=false
OPENROUTER_APP_NAME=Mutate Page

# A reservation is charged against the cap while a request is running. Keep
# this above the maximum expected cost of one request for the selected model.
# These six are just the starting defaults — adjustable at runtime from
# /admin without a redeploy once the app has started.
DAILY_OPENROUTER_BUDGET_USD=1.00
OPENROUTER_COST_RESERVATION_USD=0.10
MAX_CONCURRENT_GENERATIONS=2
MUTATION_STALE_AFTER_SECONDS=600
VISITOR_DAILY_MUTATION_LIMIT=20
MUTATION_COOLDOWN_SECONDS=10

# Set true to exercise the whole mutation flow without calling OpenRouter.
DEMO_MODE=false

# Cloudflare R2. If all four values are blank, development uses ./data/objects.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
LOCAL_OBJECT_STORAGE_PATH=./data/objects

# /admin uses HTTP Basic authentication. Always deploy behind HTTPS.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-me
